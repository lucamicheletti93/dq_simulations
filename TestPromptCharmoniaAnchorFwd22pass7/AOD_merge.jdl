# Generated merging jdl (production mode)                     
# $1 = full alien path to output directory to be merged
# $2 = AliRoot version
# $3 = ROOT version
# Stage_<n>.xml made via: find <OutputDir> *Stage<n-1>/*root_archive.zip

# This is the startup script
Executable = "/alice/cern.ch/user/a/aliprod/LHC23k6/AOD_merge.sh";

Jobtag = 
{
   "comment:AODmerge_${LPMProductionTag}: AOD merging"
};

# List of requested packages
Packages = 
{
  "VO_ALICE@O2sim::PARENT"
};

# all are needed
#Requirements = member(other.GridPartitions,"multicore_8");
#CPUCores = "8";
#MemorySize = "64GB";

# Collection of files to be merged for current stage
InputDataCollection = 
{
   "LF:$1/aod_collection.xml,nodownload"
};

LPMCollectionEntity="AO2D.root";

# Output directory
OutputDir = "$1/#alien_counter_03i#";

# List of input files to be uploaded to workers
#InputFile = 
#{
#   "LF:/alice/validation/qa/validation_merge.rc"
#};

# We split per SE for merging in stages
Split = "se";
# Time after which the job is killed (1166 min.)
TTL = "36000";
# Maximum number of input files to be merged in one go
#SplitMaxInputFileNumber = "6";

MaxOutputSize = "3221225472";

# Format of input data
InputDataListFormat = "xml-single";
# Collection name to be processed on each worker node
InputDataList = "wn.xml";

Arguments="wn.xml";

# Files to be archived
Output = 
{
    "AOD_log_archive.zip:std*,fileinfo*.log@disk=2",
    "AO2D*.root@^disk=3"
};

# AliEn price for this job
Price = "200.0";
# Validation script to be run for each subjob
Validationcommand = "/alice/cern.ch/user/a/aliprod/LHC22k4_nightly/validation.sh";
FilesToCheck="AO2D.root";

Workdirectorysize = {"10000MB"};
# JDL variables
JDLVariables = 
{
   "Packages",
   "OutputDir",
   "FilesToCheck"
};
